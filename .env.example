# Production origin, no trailing slash.
# Used for canonical URLs, Open Graph, the sitemap, robots, and JSON-LD.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only. Used by POST /api/contact to append a row to Google Sheets.
# Never prefix these with NEXT_PUBLIC_.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
